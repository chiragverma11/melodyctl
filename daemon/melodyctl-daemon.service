[Unit]
Description=melodyctl daemon (HeyMelody-family earbuds, OPOv1/RFCOMM)
Documentation=https://github.com/chiragverma11/melodyctl
After=bluetooth.target
Wants=bluetooth.target

[Service]
Type=simple
# The installed CLI - `uv tool install` puts the shim in ~/.local/bin. Adjust
# if your install lives elsewhere (check with `command -v melodyctl`):
ExecStart=%h/.local/bin/melodyctl daemon
# Your earbuds' address, if it is not the built-in default:
# Environment=MELODYCTL_ADDR=6C:0D:E1:5F:DB:4D
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
